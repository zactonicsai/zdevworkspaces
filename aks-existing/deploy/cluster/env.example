# Copy to env.sh (git-ignored), fill in, then `source deploy/cluster/env.sh` before running
# any script in deploy/cluster or deploy/prod. One file drives both layers.

# --- which cloud --------------------------------------------------------------------------
PROVIDER=aws                 # aws | gcp | azure | onprem
CLUSTER_NAME=devspaces-prod
REGION=us-east-1             # aws region | gcp region | azure location | (ignored on-prem)
K8S_VERSION=1.36

# --- node pools ---------------------------------------------------------------------------
STANDARD_INSTANCE=m6i.2xlarge      # aws: m6i.2xlarge | gcp: n2-standard-8 | azure: Standard_D8s_v5
STANDARD_MIN=2; STANDARD_MAX=20
LAB_INSTANCE=m6i.4xlarge           # bare-metal/metal instances if drivers need real PCI devices
LAB_MIN=0;      LAB_MAX=5
SYSTEM_INSTANCE=m6i.large          # platform pods (portal, proxy, ingress, cert-manager)

# --- identity -----------------------------------------------------------------------------
OIDC_ISSUER_URL=https://login.example.com/
OIDC_CLIENT_ID=devspaces
OIDC_USERNAME_CLAIM=email
OIDC_GROUPS_CLAIM=groups
PLATFORM_ADMIN_GROUP=devspaces:platform-admins

# --- registry / artifactory ---------------------------------------------------------------
REGISTRY=artifactory.corp.example/devspaces-docker
TAG=2026.10
ARTIFACTORY_URL=https://artifactory.corp.example/artifactory

# --- portal -------------------------------------------------------------------------------
PORTAL_HOST=workspaces.corp.example
INGRESS_CLASS=nginx                 # nginx | alb | gce | webapprouting.kubernetes.azure.com
CERT_ISSUER=letsencrypt             # cert-manager ClusterIssuer name ("" when the LB terminates TLS)
ACME_EMAIL=platform@corp.example

# --- add-ons (deploy/cluster/addons.sh) ---------------------------------------------------
INSTALL_INGRESS_NGINX=true
INSTALL_CERT_MANAGER=true
INSTALL_METRICS_SERVER=true
INSTALL_MULTUS=false                # multicast mode multus (on-prem L2)
ENABLE_CILIUM_MULTICAST=false       # multicast mode cilium (requires Cilium in VXLAN mode)
MULTICAST_GROUPS="239.255.0.0/24"
INSTALL_SMARTER_DEVICE_MANAGER=false
INSTALL_GVISOR=false                # notes only; installed by node image / DaemonSet
INSTALL_KATA=false                  # kata-deploy DaemonSet on the lab pool

# --- helm values for the Kubernetes layer -------------------------------------------------
VALUES_FILE=charts/devspaces/examples/values-aws.yaml
SECRETS_VALUES_FILE=deploy/prod/secrets.values.yaml   # git-ignored; clientId/clientSecret/cookieSecret/pull secret
