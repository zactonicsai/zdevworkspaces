#!/bin/sh
# git credential helper: answers "get" from the Secret mounted at /etc/workspace/git.
# The token is read at use time and never written to the home volume.
[ "$1" = "get" ] || exit 0
if [ -r /etc/workspace/git/token ]; then
  user=$(cat /etc/workspace/git/username 2>/dev/null)
  echo "username=${user:-x-access-token}"
  echo "password=$(cat /etc/workspace/git/token)"
fi
