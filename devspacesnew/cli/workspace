#!/usr/bin/env python3
"""
workspace — on-demand Kubernetes developer workspaces.

Single-file CLI, Python 3.9+, standard library only. Every cluster operation
goes through `kubectl`, so your kubeconfig, contexts, auth plugins and RBAC
apply exactly as they do on the command line.

  workspace create --lang rust --tools cmake,git
  workspace cluster                   # which cluster/context am I on, nodes, workspaces, pods
  workspace ssh rust                  # or in VS Code: Remote-SSH → "ws-rust"
  workspace code rust                 # opens VS Code on /workspace
  workspace stop rust                 # pod removed, home volume kept
  workspace start rust                # also happens automatically on ssh
  workspace delete rust               # pod gone, HOME DRIVE kept (shows in `drives list`)
  workspace delete rust --purge       # really deletes the drive too

Home drives, sharing, networking:
  workspace drives list                              # my home/shared drives, attached or not
  workspace create api --lang go --from-drive ws-rust-home   # put a new workspace on an old drive
  workspace drives snapshot rust                     # VolumeSnapshot; --from-snapshot restores
  workspace drives create-shared team-data --size 100Gi      # RWX folder; --mount shared:team-data
  workspace share add rust bob@corp.example --key bob.pub    # pair programming (bob: workspace ssh alice/rust)
  workspace link add api --to bob@corp.example/api  # allow pod-to-pod traffic across namespaces
  workspace net api                                  # DNS name, peers, links

Platform admins:
  workspace admin onboard alice --lab                # per-developer namespaces
  workspace admin project create checkout --members alice,bob   # a shared "virtual namespace"
  workspace admin reap --all-namespaces              # what the reaper CronJob runs
"""
from __future__ import annotations

