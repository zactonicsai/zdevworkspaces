{
  "realm": "devspaces",
  "enabled": true,
  "displayName": "Developer Workspaces (demo realm)",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 86400,
  "oauth2DeviceCodeLifespan": 600,
  "oauth2DevicePollingInterval": 5,
  "roles": {
    "realm": [
      {
        "name": "developer",
        "description": "may use the workspaces portal"
      },
      {
        "name": "platform-admin",
        "description": "platform team"
      }
    ]
  },
  "groups": [
    {
      "name": "developers",
      "path": "/developers",
      "realmRoles": [
        "developer"
      ]
    },
    {
      "name": "platform-admins",
      "path": "/platform-admins",
      "realmRoles": [
        "developer",
        "platform-admin"
      ]
    }
  ],
  "defaultRoles": [
    "offline_access",
    "uma_authorization",
    "developer"
  ],
  "users": [
    {
      "username": "alice@example.com",
      "email": "alice@example.com",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Developer",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "alice",
          "temporary": false
        }
      ],
      "groups": [
        "/developers"
      ]
    },
    {
      "username": "bob@example.com",
      "email": "bob@example.com",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Developer",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "bob",
          "temporary": false
        }
      ],
      "groups": [
        "/developers"
      ]
    },
    {
      "username": "admin@example.com",
      "email": "admin@example.com",
      "emailVerified": true,
      "firstName": "Pat",
      "lastName": "Platform",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "groups": [
        "/platform-admins"
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "devspaces-api",
      "description": "audience devspaces-api in access tokens",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "audience devspaces-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "devspaces-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "groups",
      "description": "group membership as a flat list",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "devspaces-portal",
      "name": "Workspaces portal (browser)",
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8080/*",
        "http://127.0.0.1:8080/*"
      ],
      "webOrigins": [
        "http://localhost:8080",
        "http://127.0.0.1:8080"
      ],
      "rootUrl": "http://localhost:8080",
      "baseUrl": "/",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/*##http://127.0.0.1:8080/*"
      },
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "devspaces-api",
        "groups"
      ],
      "optionalClientScopes": [
        "offline_access"
      ]
    },
    {
      "clientId": "devspaces-cli",
      "name": "wsctl (device code)",
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "true",
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "devspaces-api",
        "groups"
      ],
      "optionalClientScopes": [
        "offline_access"
      ]
    },
    {
      "clientId": "devspaces-api",
      "name": "Workspaces API (audience)",
      "protocol": "openid-connect",
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "defaultClientScopes": [
        "profile",
        "email"
      ]
    },
    {
      "clientId": "oauth2-proxy",
      "name": "oauth2-proxy (session mode, optional)",
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "oauth2-proxy-demo-secret",
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:8080/oauth2/callback",
        "http://localhost:4180/oauth2/callback"
      ],
      "webOrigins": [
        "http://localhost:8080"
      ],
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "groups"
      ]
    },
    {
      "clientId": "devspaces-smoke",
      "name": "smoke tests (password grant \u2014 demo realm only)",
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "devspaces-api",
        "groups"
      ],
      "optionalClientScopes": [
        "offline_access"
      ]
    }
  ]
}