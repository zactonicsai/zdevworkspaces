#!/usr/bin/env python3
"""
workspace — on-demand Kubernetes developer workspaces.

Single-file CLI, Python 3.9+, standard library only. Every cluster operation
goes through `kubectl`, so your kubeconfig, contexts, auth plugins and RBAC
apply exactly as they do on the command line.

  workspace create --lang rust --tools cmake,git
  workspace cluster                   # which cluster/context am I on, nodes, workspaces, pods
  workspace ssh rust                  # or in VS Code: Remote-SSH → "ws-rust"
  workspace code rust                 # opens VS Code on /workspace
  workspace stop rust                 # pod removed, home volume kept
  workspace start rust                # also happens automatically on ssh
  workspace delete rust --purge       # also deletes the volume

Platform admins:
  workspace admin onboard alice --lab                # per-developer namespaces
  workspace admin reap --all-namespaces              # what the reaper CronJob runs
"""
from __future__ import annotations

import argparse
import base64
import datetime as dt
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from urllib.parse import urlparse

