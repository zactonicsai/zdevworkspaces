ANN_IDLE = "devspaces.io/idle-timeout"
ANN_ACTIVE = "devspaces.io/last-active"
ANN_SPEC = "devspaces.io/spec"
ANN_NETWORKS = "k8s.v1.cni.cncf.io/networks"

SSH_PORT = 2222
DEV_USER = "dev"
DEV_GID = 1000
NAME_RE = re.compile(r"^[a-z0-9]([-a-z0-9]{0,38}[a-z0-9])?$")
NO_NS = object()  # sentinel: run kubectl without -n

# Mirrors deploy/platform/catalog.json. The cluster copy always wins; this is
