#!/usr/bin/env python3
"""mcast-check [--group 239.255.0.42] [--port 5007] [--iface net1] [--ttl 8] [--listen]

Joins GROUP on IFACE, sends a datagram and reports whether it was received. With
--listen it only prints what arrives (run it in another workspace to prove
cross-pod delivery). Exit 0 = multicast works on this interface.
"""
import argparse, os, socket, struct, sys, time, fcntl

def iface_ip(name):
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        return socket.inet_ntoa(fcntl.ioctl(s.fileno(), 0x8915, struct.pack("256s", name[:15].encode()))[20:24])
    finally:
        s.close()

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--group", default="239.255.0.42"); ap.add_argument("--port", type=int, default=5007)
    ap.add_argument("--iface", default=os.environ.get("WORKSPACE_MCAST_IFACE") or "eth0")
    ap.add_argument("--ttl", type=int, default=8); ap.add_argument("--listen", action="store_true")
    ap.add_argument("--timeout", type=float, default=3.0)
    a = ap.parse_args()
    try:
        local = iface_ip(a.iface)
    except OSError as e:
        print(f"no address on {a.iface}: {e}"); return 2
    rx = socket.socket(socket.AF_INET, socket.SOCK_DGRAM, socket.IPPROTO_UDP)
    rx.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    rx.bind(("" , a.port))
    rx.setsockopt(socket.IPPROTO_IP, socket.IP_ADD_MEMBERSHIP, socket.inet_aton(a.group) + socket.inet_aton(local))
    rx.settimeout(a.timeout)
    print(f"joined {a.group}:{a.port} on {a.iface} ({local})")
    if a.listen:
        print("listening... Ctrl-C to stop")
        rx.settimeout(None)
        while True:
            data, src = rx.recvfrom(65535)
            print(f"{time.strftime('%H:%M:%S')} {src[0]}:{src[1]} {data[:80]!r}")
    tx = socket.socket(socket.AF_INET, socket.SOCK_DGRAM, socket.IPPROTO_UDP)
    tx.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_IF, socket.inet_aton(local))
    tx.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_TTL, a.ttl)
    tx.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_LOOP, 1)
    payload = f"mcast-check {socket.gethostname()} {time.time():.3f}".encode()
    tx.sendto(payload, (a.group, a.port))
    try:
        data, src = rx.recvfrom(65535)
        print(f"received {len(data)} bytes from {src[0]} — multicast OK on {a.iface}")
        return 0
    except socket.timeout:
        print(f"nothing received within {a.timeout}s: check rp_filter, the NAD route for 224.0.0.0/4, "
              f"and that {a.iface} is the interface your library binds to")
        return 1

if __name__ == "__main__":
    sys.exit(main())
