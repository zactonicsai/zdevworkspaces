# "Bring your own AKS + Istio" — copy to env.sh (git-ignored) and fill in. Only the first
# block is required; everything else has a working default or is auto-detected by 00-detect.sh.

# --- the cluster you already have ---------------------------------------------------------
SUBSCRIPTION=""                      # empty = the az CLI's current subscription
RESOURCE_GROUP=my-aks-rg
CLUSTER_NAME=my-aks
KUBE_CONTEXT=""                      # empty = <CLUSTER_NAME> after az aks get-credentials; set to use a kubeconfig context you already have

# --- what to install ----------------------------------------------------------------------
SYSTEM_NS=devspaces-system           # the portal, catalog, reaper live here (the CLI/portal expect this name)
RELEASE=devspaces
CHART=                                # empty = the chart in this repository (charts/devspaces)
REGISTRY=ghcr.io/example/devspaces   # where workspace-*/portal images are (ACR: <name>.azurecr.io/devspaces, or Artifactory)
TAG=2026.11
PULL_SECRET_DOCKERCONFIG=""          # base64 ~/.docker/config.json if the registry needs a login (ACR attached to AKS: leave empty)
ARTIFACTORY_URL=""                   # empty = tools download from their upstream sites (fine for a trial)

# --- how people sign in -------------------------------------------------------------------
AUTH=dev                             # dev   = portal runs as DEV_USER, reachable via `kubectl port-forward` (trial / single developer);
                                     #         60-virtualservice.sh can still publish it through the gateway, IP-restricted (ALLOW_CIDRS)
                                     # entra = oauth2-proxy with Entra ID + bearer tokens for wsctl; needs the four ENTRA_* values
                                     # oidc  = any OpenID Connect provider (Keycloak, Okta, …): browser PKCE login + bearer tokens,
                                     #         no proxy; needs OIDC_ISSUER and the two OIDC_*_CLIENT_ID values
DEV_USER=you@corp.example            # AUTH=dev: the identity every portal call runs as (must be a real RBAC subject if you onboard by e-mail)
PORTAL_HOST=workspaces.corp.example  # DNS name pointing at the Istio ingress gateway's public IP (entra/oidc, and 60-virtualservice.sh)
ALLOW_CIDRS=""                       # 60/70 scripts: only these client IPs may use the route, e.g. "203.0.113.7/32,198.51.100.0/24".
                                     # Required for AUTH=dev through the gateway (a no-login portal must never be open to the world).
EXISTING_GATEWAY=""                  # 60/70 scripts: reuse a Gateway you already have ("namespace/name"); empty = create "devspaces"
APPS_DOMAIN=""                       # 70-expose-workspace.sh: apps get <workspace>-<developer>.<APPS_DOMAIN>; empty = apps.<PORTAL_HOST>
OIDC_ISSUER=""                       # AUTH=oidc: e.g. https://keycloak.corp.example/realms/devspaces
OIDC_PORTAL_CLIENT_ID=devspaces-portal   # public client, PKCE, redirect https://<PORTAL_HOST>/*
OIDC_CLI_CLIENT_ID=devspaces-cli         # public client with the device authorization grant (wsctl)
OIDC_AUDIENCE=devspaces-api          # audience the API requires in access tokens (Keycloak: a client scope with an audience mapper)
OIDC_JWKS_URI=""                     # empty = <issuer>/protocol/openid-connect/certs (Keycloak); set for other providers
ENTRA_TENANT_ID=""                   # from ../30-entra.sh, or the Entra portal
ENTRA_PORTAL_CLIENT_ID=""            # devspaces-portal app (web) — oauth2-proxy
ENTRA_PORTAL_CLIENT_SECRET=""        #   its client secret
ENTRA_CLI_CLIENT_ID=""               # devspaces-cli app (public client) — wsctl device-code login
API_AUDIENCE=api://devspaces
TLS_CREDENTIAL_NAME=""               # TLS Secret in the ingress gateway namespace (cert-manager / Key Vault); empty = HTTP only

# --- mesh ---------------------------------------------------------------------------------
MESH_MODE=auto                       # auto = ambient if ztunnel is running, else sidecar | istio-ambient | istio-sidecar | none
ISTIO_REVISION=auto                  # auto = detect (AKS add-on: asm-1-xx; self-managed: default)

# --- developers and sample workspaces ------------------------------------------------------
DEVELOPERS="alice@corp.example bob@corp.example"   # onboarded by 40-dev-pods.sh (AUTH=dev: use DEV_USER)
LAB_NAMESPACES=false                 # also create ws-<user>-lab (needs a tainted lab pool; false on a shared cluster)
PROJECT=team-demo                    # a project namespace all DEVELOPERS share ("" = none)
SAMPLE_WORKSPACES="go:go python:python"            # name:lang pairs created for the first developer; "" = none
SAMPLE_TOOLS=ripgrep,git
WORKSPACE_IDLE=2h
