# Azure cluster layer — copy to env.sh next to this file (git-ignored) and `source` it.
# Everything the azure/*.sh scripts need is here; deploy/cluster/env.sh (the cloud-agnostic
# file) is sourced too if present, and these values win.

# --- subscription / naming ---------------------------------------------------------------
SUBSCRIPTION=""                        # empty = the az CLI's current subscription
LOCATION=eastus2
RESOURCE_GROUP=devspaces-prod-rg
CLUSTER_NAME=devspaces-prod
K8S_VERSION=1.36                       # `az aks get-versions -l $LOCATION -o table`
TAGS="owner=platform team=devspaces env=prod"

# --- network -----------------------------------------------------------------------------
VNET_NAME=devspaces-vnet
VNET_CIDR=10.10.0.0/16
NODES_SUBNET=nodes;  NODES_CIDR=10.10.0.0/20
APPGW_SUBNET=appgw;  APPGW_CIDR=10.10.16.0/24     # Application Gateway for Containers / ingress LB
POD_CIDR=10.244.0.0/16                            # overlay pod range (Azure CNI overlay)
SERVICE_CIDR=10.96.0.0/16; DNS_SERVICE_IP=10.96.0.10
PRIVATE_CLUSTER=false                             # true = API server reachable only from the VNet / VPN

# --- node pools --------------------------------------------------------------------------
SYSTEM_SIZE=Standard_D4s_v5;    SYSTEM_COUNT=2
WORKSPACES_SIZE=Standard_D8s_v5; WORKSPACES_MIN=2; WORKSPACES_MAX=20; WORKSPACES_OSDISK=128
LAB_SIZE=Standard_D16s_v5;      LAB_MIN=0;       LAB_MAX=5;         LAB_OSDISK=256
LAB_GPU=false                                     # true = NVIDIA GPU driver installed on the lab pool (LAB_SIZE must be an N-series)
SPOT_POOL=false                                   # true = add a `spot` pool for cheap, interruptible workspaces
NODE_OS_SKU=Ubuntu2204                            # Ubuntu 22.04+ (containerd 2, kernel 6.x) keeps contract C2; AzureLinux also works

# --- registry ----------------------------------------------------------------------------
ACR_NAME=devspacesacr                             # globally unique, 5-50 alphanumerics; empty = use Artifactory only
REGISTRY=${ACR_NAME}.azurecr.io/devspaces          # what the chart's global.registry gets
TAG=2026.11
ARTIFACTORY_URL=https://artifactory.corp.example/artifactory

# --- identity (Entra ID) -----------------------------------------------------------------
TENANT_ID=""                                      # empty = current tenant
PORTAL_HOST=workspaces.corp.example
ENTRA_PORTAL_APP=devspaces-portal                 # web app used by oauth2-proxy (browser sign-in)
ENTRA_API_APP=devspaces-api                       # exposes api://devspaces (bearer tokens for the CLI / APIM)
ENTRA_CLI_APP=devspaces-cli                       # public client, device-code flow (wsctl login)
API_APP_ID_URI=api://devspaces
API_SCOPE=Workspaces.ReadWrite
ADMIN_GROUP_NAME=devspaces-platform-admins        # Entra security group; members become platform admins
DEVELOPERS_GROUP_NAME=devspaces-developers        # optional: only members may sign in (APIM policy + oauth2-proxy)

# --- key vault ---------------------------------------------------------------------------
KEYVAULT_NAME=devspaceskv                         # globally unique, 3-24 alphanumerics/hyphens
PLATFORM_IDENTITY=devspaces-platform-id           # user-assigned managed identity for workload identity

# --- ingress / TLS -----------------------------------------------------------------------
INGRESS=appgw-for-containers                      # appgw-for-containers | nginx
CERT_ISSUER=letsencrypt                           # cert-manager ClusterIssuer ("" if the gateway terminates TLS with a Key Vault cert)
ACME_EMAIL=platform@corp.example
INTERNAL_ONLY=false                               # true = internal load balancer (reachable via VPN/ExpressRoute only)

# --- API Management ----------------------------------------------------------------------
APIM_NAME=devspaces-apim                          # globally unique
APIM_SKU=Developer                                # Consumption | Developer | Basic | Standard | Premium
APIM_PUBLISHER_EMAIL=platform@corp.example
APIM_PUBLISHER_NAME="Platform team"
APIM_BACKEND_URL=https://${PORTAL_HOST}           # where APIM forwards (internal ingress or private IP)
APIM_API_PATH=workspaces                          # https://<apim>.azure-api.net/workspaces/api/...

# --- multicast ---------------------------------------------------------------------------
MULTICAST_GROUPS="239.255.0.0/24"
